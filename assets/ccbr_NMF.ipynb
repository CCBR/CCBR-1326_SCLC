library(NMF)
library(clustree)
PDX_only <- read.table("/data/SCLCgenomics/rajesh/ATAC_scripts/ATAC_analysis/ATAC_batch_1_2_3_quantified_peaks/normalized_data/raw_tmm_fpkm_batch_corrected_PDX_only.csv", header=T, row.names=1, check.names=T, sep=",")
colnames(PDX_only) <- gsub(pattern="X", replacement = "", colnames(PDX_only))

# removing any non-negative or zero row values 
any(PDX_only <0) ## to check if any negative value is present or not
PDX_df_nmf <- na.omit(PDX_only) ## to check if any NA values are there in df and remove them
row_sums <- rowSums(PDX_df_nmf)
PDX_rows <- PDX_df_nmf[row_sums != 0, ] ## filtered dataframe with non-zero values

## Applying NMF
nmf_clustree <- data.frame(row.names = colnames(PDX_rows)) #Create an empty dataframe
for (i in seq(2, 4)){ #Loop through all possible number of cluster
  nmf_obj <- nmf(PDX_rows, i)
  pred_nmf <- NMF::predict(nmf_obj, what = "column")
  pred <- list(pred_nmf)
  names(pred) <- paste0("k", i)
  nmf_clustree <- cbind(nmf_clustree,  pred)
  print(paste0("Work done for k", i))
}
#### Using the top 1% most variable peaks for clustering for patient only dataset
mat <- as.matrix(PDX_rows)
mats = cola::adjust_matrix(mat) ###### applied to remove the rows with too low variance (sd <= 0.05 quantile)
mads=apply(mats,1,mad) ## we are using median absolute deviation for our purpose
mats=mats[rev(order(mads))[1:3352],]
### Doing the NMF stuff for the range of K, the best methodology is this
res_new <- nmf(mats, 2:8)
## Plotting the Estimation of factorization rank
#png("/data/SCLCgenomics/rajesh/ATAC_scripts/ATAC_analysis/ATAC_batch_1_2_3_quantified_peaks/normalized_data/21_august_analysis/NMF_rank_top1_peaks_PDX.jpg", width = 2000, height = 1500, res=300)
plot(res_new)
#dev.off()
